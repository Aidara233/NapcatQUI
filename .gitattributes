# 默认：文本文件仓库存 LF，检出时统一 LF（不随平台转换）
* text=auto eol=lf

# 明确标记为文本的类型
*.cs text eol=lf
*.axaml text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.manifest text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# 二进制文件不做行尾转换
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.dll binary
*.exe binary
*.pdb binary
